# Required: your Anthropic API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# Optional: YouTube research before script writing (https://console.apify.com/settings/integrations)
# Set this to enable the two Apify actors. Generation still works without it.
APIFY_TOKEN=
# RESEARCH_ENABLED=true
# RESEARCH_MAX_VIDEOS=3          # 1-3 full transcripts per video
# RESEARCH_TIMEOUT_SECONDS=180  # total Apify time budget; analysis has a separate 45s timeout
# RESEARCH_MAX_APIFY_USD=0.50    # total actor charge ceiling per research attempt
# RESEARCH_MODEL=claude-sonnet-5-5

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5   # claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5 (best)
# CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
# TTS_VOICE=en-US-AndrewMultilingualNeural   # any edge-tts voice (`edge-tts --list-voices`)
# MAX_REPAIR_ATTEMPTS=4
# MAX_CONCURRENT_JOBS=1
# RENDER_TIMEOUT_SECONDS=1800
# FFMPEG_DIR=C:\path\to\ffmpeg\bin   # only if ffmpeg isn't on PATH / auto-detected
# LATEX_DIR=C:\path\to\miktex\bin\x64
# HOST=127.0.0.1
# PORT=8000
